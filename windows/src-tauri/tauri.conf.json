{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileTidy",
  "version": "0.1.0",
  "identifier": "io.github.stupidchiu6174.filetidy",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FileTidy",
        "width": 1120,
        "height": 720,
        "minWidth": 760,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "檔案瀏覽與整理",
    "windows": {
      "nsis": {
        "languages": ["TradChinese", "English", "Japanese"],
        "displayLanguageSelector": false
      }
    }
  }
}
